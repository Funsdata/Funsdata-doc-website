# ============================================
# Funsdata 文档站点 - 环境变量配置
# ============================================
# 复制此文件为 .env.local 并根据需要修改

# --------------------------------------------
# 阿里云 CDN 配置（推荐生产环境使用）
# --------------------------------------------
# 阿里云 CDN 基础 URL（主要内容源）
# 示例: https://docs-cdn.funsdata.com
VITE_DOCS_CDN_BASE_URL=

# --------------------------------------------
# GitHub 仓库配置（用于 jsDelivr CDN 或直接访问）
# --------------------------------------------
# 文档仓库所有者
VITE_DOCS_REPO_OWNER=Funsdata

# 文档仓库名称
VITE_DOCS_REPO_NAME=FunsdataBI-doc

# 文档仓库分支
VITE_DOCS_REPO_BRANCH=master

# 是否使用 jsDelivr CDN 代理 GitHub（推荐开启，无 rate limit）
# 设为 false 可禁用，将直接访问 GitHub Raw
VITE_DOCS_USE_JSDELIVR=true

# --------------------------------------------
# 其他配置
# --------------------------------------------
# 文档请求超时时间（毫秒）
VITE_DOCS_REQUEST_TIMEOUT=8000

# --------------------------------------------
# 构建时使用的环境变量（用于 generate-doc-manifests.mjs）
# --------------------------------------------
# GitHub Token（用于构建时从 GitHub 拉取文档，可选）
# 提高 API rate limit：未认证 60次/小时 → 认证 5000次/小时
# DOCS_GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# 本地文档镜像目录（可选，用于离线开发）
# DOCS_LOCAL_MIRROR=../FunsdataBI-doc
